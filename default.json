{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "labels": ["dependencies"],
  "lockFileMaintenance": { "enabled": true },
  "rangeStrategy": "pin",
  "minimumReleaseAge": "7d",
  "automerge": true,
  "automergeType": "branch",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }, {
      "matchPackageNames": ["node"],
      "rangeStrategy": "replace",
      "automerge": false
    }
  ]
}
